<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="5dp">

    <LinearLayout
        android:id="@+id/cardRoot"
        android:layout_width="match_parent"
        android:layout_height="118dp"
        android:background="@drawable/bg_card_channel"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBadge"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:background="@drawable/bg_monogram_badge"
                android:gravity="center"
                android:minWidth="40dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="ZEE"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/ivFavorite"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Favorite"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/ic_star_outline"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvChannelName"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:text="Zee Telugu"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCategory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Entertainment"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/ivPlayDot"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Now Playing"
                android:src="@drawable/ic_play"
                android:visibility="gone"
                app:tint="@color/accent_gold_bright" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
