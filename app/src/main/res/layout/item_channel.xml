<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="5dp">

    <LinearLayout
        android:id="@+id/cardRoot"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:background="@drawable/bg_card_channel"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="13dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBadge"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:background="@drawable/bg_monogram_badge"
                android:gravity="center"
                android:minWidth="36dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="ZEE"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/ivFavorite"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Favorite"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/ic_star_outline"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvChannelName"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:text="Zee Telugu"
            android:textColor="@color/text_primary"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCategory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Entertainment"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/ivPlayDot"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="Now Playing"
                android:src="@drawable/ic_play"
                android:visibility="gone"
                app:tint="@color/accent_gold_bright" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
