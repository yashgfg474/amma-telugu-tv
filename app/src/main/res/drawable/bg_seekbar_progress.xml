<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical">
        <shape android:shape="rectangle">
            <size android:height="6dp" />
            <corners android:radius="3dp" />
            <solid android:color="@color/border_subtle" />
        </shape>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical">
        <clip>
            <shape android:shape="rectangle">
                <size android:height="6dp" />
                <corners android:radius="3dp" />
                <gradient
                    android:angle="0"
                    android:endColor="@color/accent_gold_bright"
                    android:startColor="@color/accent_crimson" />
            </shape>
        </clip>
    </item>
</layer-list>
